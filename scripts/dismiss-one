#!/usr/bin/env bash
set -euo pipefail

file="${1:-}"

[[ -n "$file" ]] || exit 2

# Only accept a simple archived JSON filename.
[[ "$file" == "$(basename "$file")" ]] ||
  exit 2

[[ "$file" == *.json ]] ||
  exit 2

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_DIR="$STATE_HOME/ritechoice23-omarchy-notification"

ARCHIVE_DIR="$STATE_DIR/history"
IMAGE_DIR="$STATE_DIR/images"
DISMISSED_DIR="$STATE_DIR/dismissed"

mkdir -p \
  "$ARCHIVE_DIR" \
  "$IMAGE_DIR" \
  "$DISMISSED_DIR"

stem="${file%.json}"

# Prevent a still-present Omarchy history entry from being imported again.
: > "$DISMISSED_DIR/$file"

rm -f -- \
  "$ARCHIVE_DIR/$file" \
  "$IMAGE_DIR/${stem}-appIcon" \
  "$IMAGE_DIR/${stem}-image"
