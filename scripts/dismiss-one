#!/usr/bin/env bash
set -euo pipefail

(( $# > 0 )) || exit 2
for file in "$@"; do
  [[ -n "$file" && "$file" == "$(basename "$file")" && "$file" == *.json ]] || exit 2
done

STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_DIR="$STATE_HOME/ritechoice23-omarchy-notification"
ARCHIVE_DIR="$STATE_DIR/history"
IMAGE_DIR="$STATE_DIR/images"
DISMISSED_DIR="$STATE_DIR/dismissed"
mkdir -p "$ARCHIVE_DIR" "$IMAGE_DIR" "$DISMISSED_DIR"
exec 9>"$STATE_DIR/state.lock"
flock 9

for file in "$@"; do
  stem="${file%.json}"
  : > "$DISMISSED_DIR/$file"
  rm -f -- "$ARCHIVE_DIR/$file" "$IMAGE_DIR/${stem}-appIcon" "$IMAGE_DIR/${stem}-image"
done
